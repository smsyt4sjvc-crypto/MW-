{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Company power and compute economics review",
  "type": "object",
  "required": ["schema_version", "id", "entity_id", "as_of", "review_status", "method_id", "source_ids", "documents", "pue", "model", "structured_deals", "findings", "gaps"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string"},
    "entity_id": {"type": "string"},
    "as_of": {"type": "string", "format": "date"},
    "review_status": {"enum": ["complete", "partial"]},
    "method_id": {"type": "string"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "documents": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source_id", "url", "document_type", "period", "locator", "retrieved_at"], "properties": {"source_id": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "document_type": {"type": "string"}, "period": {"type": ["string", "null"]}, "locator": {"type": "string"}, "retrieved_at": {"type": "string", "format": "date-time"}}}},
    "pue": {"type": "object", "required": ["status", "reported", "low", "base", "high", "boundary", "period", "basis", "source_ids"], "properties": {"status": {"enum": ["reported", "inferred", "proxy", "not_disclosed", "not_applicable"]}, "reported": {"type": ["number", "null"], "minimum": 1}, "low": {"type": ["number", "null"], "minimum": 1}, "base": {"type": ["number", "null"], "minimum": 1}, "high": {"type": ["number", "null"], "minimum": 1}, "boundary": {"type": "string"}, "period": {"type": ["string", "null"]}, "basis": {"type": "string"}, "source_ids": {"type": "array", "items": {"type": "string"}}}},
    "model": {"type": "object", "required": ["revenue_period", "revenue_scope", "power_scope", "capacity_time_basis", "inputs", "formulas", "outputs", "assumptions"], "properties": {"revenue_period": {"type": ["string", "null"]}, "revenue_scope": {"type": "string"}, "power_scope": {"enum": ["generation", "facility", "it_load", "effective_utilized_it", "not_disclosed", "not_applicable"]}, "capacity_time_basis": {"type": "string"}, "inputs": {"type": "object"}, "formulas": {"type": "object"}, "outputs": {"type": "array", "items": {"type": "object", "required": ["metric", "unit", "value", "evidence", "source_ids"], "properties": {"metric": {"type": "string"}, "unit": {"type": "string"}, "value": {"type": ["number", "null"]}, "low": {"type": ["number", "null"]}, "high": {"type": ["number", "null"]}, "evidence": {"enum": ["reported", "derived", "modeled", "open", "not_applicable"]}, "source_ids": {"type": "array", "items": {"type": "string"}}}}}, "assumptions": {"type": "array", "items": {"type": "object", "required": ["input", "value", "basis", "source_ids"], "properties": {"input": {"type": "string"}, "value": {}, "basis": {"type": "string"}, "source_ids": {"type": "array", "items": {"type": "string"}}}}}}},
    "structured_deals": {"type": "array", "items": {"type": "object", "required": ["type", "counterparties", "status", "source_ids", "economic_effect"], "properties": {"type": {"type": "string"}, "counterparties": {"type": "array", "items": {"type": "string"}}, "status": {"type": "string"}, "source_ids": {"type": "array", "items": {"type": "string"}}, "economic_effect": {"type": "string"}}}},
    "findings": {"type": "array", "items": {"type": "string"}},
    "gaps": {"type": "array", "items": {"type": "string"}}
  }
}
